# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / lint
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Data — large or redistributability-uncertain raw/interim artifacts are
# not committed. See data/README.md for recreation instructions.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Experimental outputs — regenerated by running the pipeline, not hand
# edited, and can be large. Keep the directory structure via README/.gitkeep.
results/*.jsonl
results/*.csv
results/*.json
!results/README.md
figures/*.png
figures/*.pdf
!figures/README.md

# Model caches
.cache/
*.bin
*.safetensors

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
