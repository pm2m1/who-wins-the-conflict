# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Local secrets — this project currently reads no environment variables
# for credentials, but any future .env (e.g. HF_TOKEN for gated model
# access) must never be committed. .env.example is a template and is
# explicitly kept even though the .env* pattern would otherwise exclude
# it (docs/decisions.md, "Local secret-file protection").
.env
.env.*
!.env.example

# Test / lint
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Data — large or redistributability-uncertain raw/interim artifacts are
# not committed. See data/README.md for recreation instructions.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Experimental outputs — regenerated by running the pipeline, not hand
# edited, and can be large. Keep the directory structure via README/.gitkeep.
results/*.jsonl
results/*.csv
results/*.json
!results/README.md
figures/*.png
figures/*.pdf
!figures/README.md

# Model caches
.cache/
*.bin
*.safetensors

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
